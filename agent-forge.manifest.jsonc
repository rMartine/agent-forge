{
  "schemaVersion": 6,
  "rosterCatalog": "config/roster-catalog.json",
  "rosterRuntimeRoots": {
    "codex": "%USERPROFILE%/.agent-forge/codex/runtime",
    "vscode": "%USERPROFILE%/.agent-forge/copilot/runtime",
    "opencode": "%USERPROFILE%/.agent-forge/opencode/runtime"
  },
  "platforms": [
    "vscode",
    "codex"
  ],
  "scope": "user",
  "targets": {
    "vscode": {
      "agents": "%USERPROFILE%/.copilot/agents",
      "instructions": "%USERPROFILE%/.copilot/instructions",
      "skills": "%USERPROFILE%/.copilot/skills",
      "hooks": "%USERPROFILE%/.copilot/hooks"
    },
    "codex": {
      "agents": "%USERPROFILE%/.codex/agents",
      "skills": "%USERPROFILE%/.agents/skills",
      "hooks": "%USERPROFILE%/.codex/hooks.json"
    },
    "state": "%USERPROFILE%/.agent-forge/state.json"
  },
  "capabilityCatalog": "config/capability-catalog.jsonc",
  "modelProfiles": "config/model-profiles.jsonc",
  "mcpProviders": "config/mcp-providers.jsonc",
  "agents": {},
  "instructions": [],
  "skills": [],
  "hooks": [],
  "codex": {
    "agents": {},
    "skillBundles": {},
    "graphify": {
      "managedRoot": "%USERPROFILE%/.agent-forge/graphify",
      "lockFile": "config/graphify-windows-x64-python312.lock.json"
    }
  }
}
