{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-forge.local/schemas/agent-forge-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "platform", "scope", "targets", "agents", "instructions", "skills", "hooks"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "platform": { "const": "vscode" },
    "scope": { "const": "user" },
    "targets": {
      "type": "object",
      "required": ["agents", "instructions", "skills", "hooks", "state"],
      "additionalProperties": false,
      "properties": {
        "agents": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "skills": { "type": "string", "minLength": 1 },
        "hooks": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "agents": { "type": "object", "minProperties": 1 },
    "instructions": { "type": "array" },
    "skills": { "type": "array" },
    "hooks": { "type": "array" }
  }
}
