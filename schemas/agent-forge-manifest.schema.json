{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-forge.local/schemas/agent-forge-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platforms",
    "scope",
    "targets",
    "capabilityCatalog",
    "modelProfiles",
    "mcpProviders",
    "agents",
    "instructions",
    "skills",
    "hooks",
    "codex"
  ],
  "properties": {
    "copilotFourRosters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "runtimeRoot",
        "defaultHarness",
        "mcpProviders"
      ],
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "runtimeRoot": {
          "type": "string",
          "minLength": 1
        },
        "defaultHarness": {
          "enum": [
            "copilot",
            "local"
          ]
        },
        "mcpProviders": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaVersion": {
      "enum": [
        3,
        4,
        5,
        6
      ]
    },
    "platforms": {
      "type": "array",
      "const": [
        "vscode",
        "codex"
      ]
    },
    "scope": {
      "const": "user"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vscode",
        "codex",
        "state"
      ],
      "properties": {
        "vscode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agents",
            "instructions",
            "skills",
            "hooks"
          ],
          "properties": {
            "agents": {
              "type": "string",
              "minLength": 1
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "string",
              "minLength": 1
            },
            "hooks": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agents",
            "skills"
          ],
          "properties": {
            "agents": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "string",
              "minLength": 1
            },
            "hooks": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilityCatalog": {
      "type": "string",
      "minLength": 1
    },
    "modelProfiles": {
      "type": "string",
      "minLength": 1
    },
    "mcpProviders": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "skillBundles"
      ],
      "properties": {
        "agents": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": {
            "$ref": "#/$defs/codexAgent"
          }
        },
        "skillBundles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/codexBundle"
          }
        },
        "externalSkillCatalog": {
          "type": "string",
          "minLength": 1
        },
        "productDevelopment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "deploymentName",
            "hooksSource",
            "hooksTarget"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "deploymentName": {
              "type": "string",
              "pattern": "^agent-forge-[a-z0-9-]+$"
            },
            "hooksSource": {
              "type": "string",
              "minLength": 1
            },
            "hooksTarget": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "graphify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managedRoot",
            "lockFile"
          ],
          "properties": {
            "managedRoot": {
              "type": "string",
              "minLength": 1
            },
            "lockFile": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\:\\u0000-\\u001f]+$"
            }
          }
        }
      }
    },
    "rosterCatalog": {
      "type": "string",
      "minLength": 1
    },
    "rosterRuntimeRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "vscode",
        "opencode"
      ],
      "properties": {
        "codex": {
          "type": "string",
          "minLength": 1
        },
        "vscode": {
          "type": "string",
          "minLength": 1
        },
        "opencode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "visibility",
        "capabilityProfile",
        "modelProfile",
        "requiredSkills",
        "optionalSkills",
        "allowedSubagents",
        "handoffs",
        "requiredCapabilities",
        "optionalCapabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "type": "string",
          "pattern": "^agents/.+\\.agent\\.md$"
        },
        "visibility": {
          "enum": [
            "entry",
            "worker"
          ]
        },
        "capabilityProfile": {
          "$ref": "#/$defs/identifier"
        },
        "modelProfile": {
          "enum": [
            "inherit",
            "reasoning",
            "coding",
            "creative",
            "balanced"
          ]
        },
        "requiredSkills": {
          "$ref": "#/$defs/stringArray"
        },
        "optionalSkills": {
          "$ref": "#/$defs/stringArray"
        },
        "allowedSubagents": {
          "$ref": "#/$defs/stringArray"
        },
        "handoffs": {
          "$ref": "#/$defs/stringArray"
        },
        "requiredCapabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "optionalCapabilities": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "codexAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceAgent",
        "sandboxMode",
        "modelProfile",
        "requiredSkillBundles",
        "instructionOverlay",
        "requiredCapabilities",
        "optionalCapabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourceAgent": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "sandboxMode": {
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "modelProfile": {
          "const": "inherit"
        },
        "requiredSkillBundles": {
          "$ref": "#/$defs/stringArray"
        },
        "instructionOverlay": {
          "type": "string"
        },
        "requiredCapabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "optionalCapabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "completionEvidence": {
          "$ref": "#/$defs/stringArray"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$"
        },
        "modelReasoningEffort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        }
      }
    },
    "codexBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deploymentName",
        "entrypoint",
        "description",
        "componentSkills",
        "flattenedReferences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentName": {
          "type": "string",
          "pattern": "^agent-forge-[a-z0-9-]+$"
        },
        "entrypoint": {
          "const": "SKILL.md"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "componentSkills": {
          "$ref": "#/$defs/stringArray"
        },
        "flattenedReferences": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "codex": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "productDevelopment"
                  ]
                },
                {
                  "required": [
                    "externalSkillCatalog"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              5,
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "codex": {
            "properties": {
              "agents": {
                "additionalProperties": {
                  "required": [
                    "model",
                    "modelReasoningEffort"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "codex": {
            "properties": {
              "agents": {
                "additionalProperties": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "model"
                        ]
                      },
                      {
                        "required": [
                          "modelReasoningEffort"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              3,
              4
            ]
          }
        }
      },
      "then": {
        "properties": {
          "codex": {
            "not": {
              "required": [
                "graphify"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 6
          }
        }
      },
      "then": {
        "required": [
          "rosterCatalog",
          "rosterRuntimeRoots"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 6
          }
        }
      },
      "then": {
        "properties": {
          "agents": {
            "maxProperties": 0
          },
          "skills": {
            "maxItems": 0
          },
          "instructions": {
            "maxItems": 0
          },
          "hooks": {
            "maxItems": 0
          },
          "targets": {
            "properties": {
              "codex": {
                "required": [
                  "hooks"
                ]
              }
            }
          },
          "codex": {
            "properties": {
              "agents": {
                "maxProperties": 0
              },
              "skillBundles": {
                "maxProperties": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "productDevelopment"
                  ]
                },
                {
                  "required": [
                    "externalSkillCatalog"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "agents": {
            "minProperties": 1
          },
          "codex": {
            "properties": {
              "agents": {
                "minProperties": 1
              }
            }
          }
        }
      }
    }
  ]
}
