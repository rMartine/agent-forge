{
  "version": 1,
  "providers": {
    "canva": { "toolPatterns": ["canva/*"] },
    "docker": { "toolPatterns": ["docker/*", "com_docker_do/*"] },
    "digitalocean": { "toolPatterns": ["digitalocean/*", "com_digitaloc/*"] },
    "github": { "toolPatterns": ["github/*", "com_github_gi/*"] },
    "gitkraken": { "toolPatterns": ["gitkraken/*"] }
  },
  "capabilities": {
    "canva-write": { "access": "write", "provider": "canva", "tools": ["canva/*"] },
    "gitkraken-read": { "access": "read", "provider": "gitkraken", "tools": ["gitkraken/git_status", "gitkraken/git_log_or_diff", "gitkraken/repository_get_file_content"] },
    "gitkraken-write": { "access": "write", "provider": "gitkraken", "tools": ["gitkraken/git_status", "gitkraken/git_log_or_diff", "gitkraken/repository_get_file_content", "gitkraken/git_add_or_commit"] },
    "github-read": { "access": "read", "provider": "github", "tools": ["github/get_file_contents", "github/list_issues", "github/get_pull_request"] },
    "github-write": { "access": "write", "provider": "github", "tools": ["github/get_file_contents", "github/list_issues", "github/get_pull_request", "github/create_issue", "github/add_issue_comment"] },
    "github-admin": { "access": "admin", "provider": "github", "tools": ["github/get_file_contents", "github/list_issues", "github/get_pull_request", "github/create_issue", "github/add_issue_comment", "github/create_pull_request", "github/merge_pull_request"] },
    "docker-read": { "access": "read", "provider": "docker", "tools": ["docker/containers-list", "docker/logs-get", "docker/images-list"] },
    "docker-write": { "access": "write", "provider": "docker", "tools": ["docker/containers-list", "docker/logs-get", "docker/images-list", "docker/compose-build", "docker/compose-up"] },
    "docker-admin": { "access": "admin", "provider": "docker", "tools": ["docker/containers-list", "docker/logs-get", "docker/images-list", "docker/compose-build", "docker/compose-up", "docker/compose-down", "docker/container-stop"] },
    "digitalocean-read": { "access": "read", "provider": "digitalocean", "tools": ["digitalocean/account-get", "digitalocean/apps-list", "digitalocean/app-get"] },
    "digitalocean-admin": { "access": "admin", "provider": "digitalocean", "tools": ["digitalocean/account-get", "digitalocean/apps-list", "digitalocean/app-get", "digitalocean/app-create-deployment", "digitalocean/app-update"] }
  },
  "profiles": {
    "strategy-read": { "builtins": ["read", "search"], "required": [], "optional": [] },
    "requirements-docs": { "builtins": ["read", "search", "edit"], "required": [], "optional": [] },
    "architecture-review": { "builtins": ["read", "search", "edit"], "required": [], "optional": [] },
    "planning": { "builtins": ["read", "search", "edit"], "required": [], "optional": [] },
    "implementation": { "builtins": ["read", "search", "edit", "execute"], "required": [], "optional": [] },
    "verification": { "builtins": ["read", "search", "edit", "execute"], "required": [], "optional": [] },
    "security-review": { "builtins": ["read", "search", "execute"], "required": [], "optional": [] },
    "operations-admin": { "builtins": ["read", "search", "edit", "execute"], "required": [], "optional": [] },
    "creative-coordination": { "builtins": ["read", "search", "agent"], "required": [], "optional": [] },
    "design-production": { "builtins": ["read", "search", "edit"], "required": [], "optional": [] },
    "documentation": { "builtins": ["read", "search", "edit", "execute"], "required": [], "optional": [] },
    "knowledge-curation": { "builtins": ["read", "search", "edit", "execute"], "required": [], "optional": [] }
  }
}
