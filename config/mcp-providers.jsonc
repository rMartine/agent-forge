{
  "version": 1,
  "providers": {
    "canva": { "requiredForFull": true, "detection": {}, "configuration": { "type": "http", "url": "https://mcp.canva.com/mcp" }, "notes": "Complete OAuth in VS Code." },
    "gitkraken": { "requiredForFull": true, "detection": { "command": "gk", "args": ["mcp", "--list-tools"] }, "configuration": { "type": "stdio", "command": "gk", "args": ["mcp"] } },
    "docker": { "requiredForFull": true, "detection": { "command": "docker", "args": ["mcp", "gateway", "run", "--help"] }, "configuration": { "type": "stdio", "command": "docker", "args": ["mcp", "gateway", "run"] } },
    "github": { "requiredForFull": true, "detection": { "command": "docker", "args": ["mcp", "server", "list"] }, "configuration": { "provider": "docker-mcp-toolkit" } },
    "digitalocean": { "requiredForFull": true, "detection": { "command": "docker", "args": ["mcp", "server", "list"] }, "configuration": { "provider": "docker-mcp-toolkit" } }
  }
}
