{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Roster de Investigación | Especialistas | PreToolUse | Comprobar límites del encargo"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Roster de Investigación | Especialistas | PostToolUse | Registrar resultado observable"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Roster de Investigación | Especialistas | SubagentStart | Preparar contexto"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Roster de Investigación | Especialistas | SubagentStop | Revisar entregables registrados"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Roster de Investigación | Sesión | Stop | Comprobar evidencia registrada"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 3,
            "statusMessage": "Roster de Investigación | Sesión | Interrupt | Registrar interrupción"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./scripts/research-hooks.mjs\"",
            "timeout": 3,
            "statusMessage": "Roster de Investigación | Sesión | SessionEnd | Cerrar registro de sesión"
          }
        ]
      }
    ]
  }
}
